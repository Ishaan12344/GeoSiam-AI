    "# \u2500\u2500 Cell 3: Setup Project Modules in /kaggle/working \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import os, sys, shutil, zipfile, io, base64\n",
    "\n",
    "KAGGLE_WORKING = '/kaggle/working'\n",
    "os.chdir(KAGGLE_WORKING)\n",
    "\n",
    "# Check if honors_code.zip or python files exist in /kaggle/input\n",
    "code_found = False\n",
    "if os.path.exists('/kaggle/input'):\n",
    "    for root, dirs, files in os.walk('/kaggle/input'):\n",
    "        for f in files:\n",
    "            src = os.path.join(root, f)\n",
    "            if f == 'honors_code.zip':\n",
    "                print(f'\ud83d\udce6 Found {f}! Unpacking into {KAGGLE_WORKING} ...')\n",
    "                with zipfile.ZipFile(src, 'r') as z:\n",
    "                    z.extractall(KAGGLE_WORKING)\n",
    "                code_found = True\n",
    "                break\n",
    "            elif f.endswith('.py') and not f.startswith('.'):\n",
    "                dest = os.path.join(KAGGLE_WORKING, 'models' if 'models' in root else '', f)\n",
    "                os.makedirs(os.path.dirname(dest), exist_ok=True)\n",
    "                shutil.copy(src, dest)\n",
    "                code_found = True\n",
    "\n",
    "# Automatic fallback: If no code zip was attached, unpack built-in project modules\n",
    "if not code_found and not os.path.exists(os.path.join(KAGGLE_WORKING, 'train.py')):\n",
    "    print('\ud83d\udce6 Unpacking built-in project modules ...')\n",
    "    EMBEDDED_ZIP_B64 = ''\n",
    "    zip_bytes = base64.b64decode(EMBEDDED_ZIP_B64)\n",
    "    with zipfile.ZipFile(io.BytesIO(zip_bytes), 'r') as z:\n",
    "        z.extractall(KAGGLE_WORKING)\n",
    "    print('\u2705 Built-in project modules extracted successfully!')\n",
    "else:\n",
    "    print('\u2705 Project code ready in /kaggle/working!')\n",
    "\n",
    "if KAGGLE_WORKING not in sys.path:\n",
    "    sys.path.insert(0, KAGGLE_WORKING)\n",
    "\n",
    "print('Working directory:', os.getcwd())\n",
    "print('sys.path[0]:', sys.path[0])\n"
   ]
