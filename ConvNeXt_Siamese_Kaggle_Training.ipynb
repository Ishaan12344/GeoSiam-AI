    "# \u2500\u2500 Cell 6: Train ConvNeXt-Tiny Siamese BDA (Dedicated Training) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Features:\n",
    "#   - Only ConvNeXt-Tiny Siamese (avoids spending hours on ResNeXt / Hybrid)\n",
    "#   - Albumentations data augmentation active\n",
    "#   - Disaster-event-aware split prevents leakage\n",
    "#   - Early stopping (patience=5)\n",
    "#   - Real-time logging of F1, Precision, Recall, and Overall EBD score\n",
    "\n",
    "from train import train_convnext_only\n",
    "\n",
    "# 20 Epochs with Early Stopping gives optimal convergence on real EBD data\n",
    "EPOCHS = 20\n",
    "\n",
    "results = train_convnext_only(\n",
    "    data_dir=data_path_to_use,\n",
    "    epochs=EPOCHS,\n",
    "    patience=5\n",
    ")"
   ]
