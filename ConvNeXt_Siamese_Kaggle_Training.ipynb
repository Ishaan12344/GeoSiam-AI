    "# \u2500\u2500 Cell 7: Plot Training Curves (Loss, IoU, Overall F1) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import json, matplotlib.pyplot as plt\n",
    "from IPython.display import Image, display\n",
    "\n",
    "hist_file = os.path.join(OUTPUT_DIR, \"ConvNeXt_Siamese_history.json\")\n",
    "if os.path.exists(hist_file):\n",
    "    with open(hist_file, \"r\") as f:\n",
    "        hist = json.load(f)\n",
    "\n",
    "    epochs_ran = range(1, len(hist[\"train_loss\"]) + 1)\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "    # Loss curve\n",
    "    ax1.plot(epochs_ran, hist[\"train_loss\"], 'b-o', label=\"Training Loss\", linewidth=2)\n",
    "    ax1.set_title(\"ConvNeXt-Tiny Siamese Training Loss\", fontsize=13, fontweight=\"bold\")\n",
    "    ax1.set_xlabel(\"Epoch\", fontsize=11)\n",
    "    ax1.set_ylabel(\"Loss\", fontsize=11)\n",
    "    ax1.grid(True, linestyle=\"--\", alpha=0.6)\n",
    "    ax1.legend()\n",
    "\n",
    "    # Validation Metrics\n",
    "    ax2.plot(epochs_ran, hist[\"val_score\"], 'g-s', label=\"Overall EBD Score\", linewidth=2)\n",
    "    ax2.plot(epochs_ran, hist[\"val_f1_loc\"], 'c-^', label=\"Localization F1\", linewidth=2)\n",
    "    ax2.plot(epochs_ran, hist[\"val_f1_damage\"], 'r-d', label=\"Harmonic Damage F1\", linewidth=2)\n",
    "    ax2.set_title(\"Validation Performance over Epochs\", fontsize=13, fontweight=\"bold\")\n",
    "    ax2.set_xlabel(\"Epoch\", fontsize=11)\n",
    "    ax2.set_ylabel(\"Score / F1\", fontsize=11)\n",
    "    ax2.grid(True, linestyle=\"--\", alpha=0.6)\n",
    "    ax2.legend()\n",
    "\n",
    "    curve_path = os.path.join(VISUALS_DIR, \"convnext_training_curves.png\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(curve_path, dpi=200)\n",
    "    plt.close()\n",
    "    display(Image(curve_path))\n",
    "    print(f\"\u2705 Saved training curves to: {curve_path}\")"
   ]
