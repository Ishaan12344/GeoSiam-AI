    "# \u2500\u2500 Cell 4: Smart EBD Dataset Detection & Strict Mask Validation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import os, glob, zipfile, tarfile\n",
    "\n",
    "KAGGLE_INPUT = \"/kaggle/input\"\n",
    "LOCAL_DATA_DIR = \"/kaggle/working/data\"\n",
    "os.makedirs(LOCAL_DATA_DIR, exist_ok=True)\n",
    "\n",
    "found_images = 0\n",
    "data_path_to_use = None\n",
    "\n",
    "if os.path.exists(KAGGLE_INPUT):\n",
    "    # Check archives first\n",
    "    for root, dirs, files in os.walk(KAGGLE_INPUT):\n",
    "        for f in files:\n",
    "            fpath = os.path.join(root, f)\n",
    "            if f.endswith(\".zip\") and any(k in f.lower() for k in [\"ebd\", \"dataset\", \"damage\", \"xbd\"]):\n",
    "                if len(os.listdir(LOCAL_DATA_DIR)) == 0:\n",
    "                    print(f\"\ud83d\udce6 Extracting {f} into {LOCAL_DATA_DIR} ...\")\n",
    "                    with zipfile.ZipFile(fpath, 'r') as z:\n",
    "                        z.extractall(LOCAL_DATA_DIR)\n",
    "                    print(\"\u2705 Extraction complete!\")\n",
    "                data_path_to_use = LOCAL_DATA_DIR\n",
    "                break\n",
    "            elif (f.endswith(\".tar.gz\") or f.endswith(\".tgz\")) and any(k in f.lower() for k in [\"ebd\", \"dataset\", \"damage\", \"xbd\"]):\n",
    "                if len(os.listdir(LOCAL_DATA_DIR)) == 0:\n",
    "                    print(f\"\ud83d\udce6 Extracting {f} into {LOCAL_DATA_DIR} ...\")\n",
    "                    with tarfile.open(fpath, 'r:gz') as t:\n",
    "                        t.extractall(LOCAL_DATA_DIR)\n",
    "                    print(\"\u2705 Extraction complete!\")\n",
    "                data_path_to_use = LOCAL_DATA_DIR\n",
    "                break\n",
    "\n",
    "    # If no archive, scan for extracted image folders\n",
    "    if not data_path_to_use:\n",
    "        for root, dirs, files in os.walk(KAGGLE_INPUT):\n",
    "            img_count = sum(1 for f in files if \"pre_disaster\" in f and not any(k in f for k in [\"target\", \"mask\", \"damage\", \"loc\"]))\n",
    "            if img_count > 0:\n",
    "                found_images += img_count\n",
    "                data_path_to_use = root\n",
    "                print(f\"\u2705 Found {img_count} pre-disaster images directly in {root}\")\n",
    "                break\n",
    "\n",
    "if not data_path_to_use or found_images == 0:\n",
    "    for root, dirs, files in os.walk(LOCAL_DATA_DIR):\n",
    "        img_count = sum(1 for f in files if \"pre_disaster\" in f and not any(k in f for k in [\"target\", \"mask\", \"damage\", \"loc\"]))\n",
    "        if img_count > 0:\n",
    "            found_images += img_count\n",
    "            data_path_to_use = root\n",
    "            break\n",
    "\n",
    "print(\"----------------------------------------------------------------------\")\n",
    "if data_path_to_use and found_images > 0:\n",
    "    print(f\"\ud83c\udfaf Active Dataset Directory: {data_path_to_use}\")\n",
    "    print(f\"\ud83d\udcca Total Discovered Bi-temporal Image Pairs: {found_images}\")\n",
    "else:\n",
    "    data_path_to_use = LOCAL_DATA_DIR\n",
    "    print(\"\u26a0\ufe0f No real EBD dataset found in /kaggle/input yet.\")\n",
    "    print(\"   Please add the EBD dataset via '+ Add Input' in the right sidebar.\")\n",
    "print(\"----------------------------------------------------------------------\")"
   ]
